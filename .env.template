APP_CONFIG__ENVIRONMENT='dev'

# Runtime settings for `entrypoint.sh` (optional).
# Note: these are NOT `APP_CONFIG__...` settings; they are read by the shell entrypoint, not by Pydantic Settings.
HOST='0.0.0.0'
PORT='8000'
WEB_CONCURRENCY='1'
WAIT_FOR_DB='0'

APP_CONFIG__DATABASE__driver='postgresql+asyncpg'
APP_CONFIG__DATABASE__user='user'
APP_CONFIG__DATABASE__password='password'
APP_CONFIG__DATABASE__host='postgres'
APP_CONFIG__DATABASE__port='5432'
APP_CONFIG__DATABASE__external_port='5433'
APP_CONFIG__DATABASE__db_name='dbname'

# Required app config (examples)
APP_CONFIG__ALLOW_ORIGINS='http://localhost:3000'

APP_CONFIG__BUCKET__supabase_url='https://YOUR_PROJECT.supabase.co'
APP_CONFIG__BUCKET__supabase_key='YOUR_SUPABASE_SERVICE_KEY'
APP_CONFIG__BUCKET__name='YOUR_BUCKET_NAME'
